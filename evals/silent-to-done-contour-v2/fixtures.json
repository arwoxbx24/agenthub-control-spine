      "input": { "gate": "done_gate", "validation_state": "PASS", "evidence_paths": ["/tmp/proof.txt"], "model_route_gate": "PASS" },
      "expected": "DONE_BLOCKED_FORBIDDEN_PATH"
    },
    {
      "id": "20-done-model-route-fail",
      "input": { "gate": "done_gate", "validation_state": "PASS", "model_route_gate": "FAIL" },
      "expected": "DONE_BLOCKED_MODEL_ROUTE"
    },
    {
      "id": "21-task-service-blocker-not-active-defect",
      "input": { "gate": "done_gate", "task_service_blocker": "TASK_SERVICE_PHYSICAL_WRITE_REPAIR_REQUIRED", "task_service_is_active_defect": false },
