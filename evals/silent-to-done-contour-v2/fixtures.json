    },
    {
      "id": "17-third-same-gate-attempt",
      "input": { "gate": "retry_budget", "same_gate_failures": 2, "third_attempt": true },
      "expected": "RETRY_CIRCUIT_BREAKER_TRIGGERED"
    },
    {
      "id": "18-blocked-restart-not-done",
      "input": { "gate": "done_gate", "validation_state": "BLOCKED_RESTART_REQUIRED", "model_route_gate": "PASS" },
      "expected": "DONE_BLOCKED_NOT_PROVEN"
    },
    {
