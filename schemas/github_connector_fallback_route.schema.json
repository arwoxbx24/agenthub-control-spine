{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "github_connector_fallback_route.schema.json",
  "title": "GitHub Connector Fallback Route",
  "type": "object",
  "required": ["primary_tool", "fallback_tool", "repository", "task_id", "run_id", "allowed_paths", "forbidden_repositories", "forbidden_operations", "evidence_required", "retry_limit", "terminal_blocker"],
  "properties": {
    "primary_tool": { "type": "string", "minLength": 1 },
    "fallback_tool": { "type": "string", "minLength": 1 },
    "repository": { "type": "string", "minLength": 1 },
    "task_id": { "type": "string", "pattern": "^[A-Z][A-Z0-9]+-[0-9]+$" },
    "run_id": { "type": "string", "minLength": 1 },
    "allowed_paths": { "type": "array", "items": { "type": "string" } },
    "forbidden_repositories": { "type": "array", "items": { "type": "string" } },
    "forbidden_operations": { "type": "array", "items": { "type": "string" } },
    "evidence_required": { "type": "array", "items": { "type": "string" } },
    "retry_limit": { "type": "integer", "maximum": 1 },
    "terminal_blocker": { "type": "string", "minLength": 1 }
  },
  "additionalProperties": false
}

