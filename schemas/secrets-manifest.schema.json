{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/arwoxbx24/agenthub-control-spine/schemas/secrets-manifest.schema.json",
  "title": "AgentHub Redacted Secrets Manifest",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "updated_at", "source_task", "run_id", "entries"],
  "properties": {
    "schema_version": { "type": "string", "const": "1.0" },
    "updated_at": { "type": "string", "format": "date-time" },
    "source_task": { "type": "string", "pattern": "^AH-[0-9]+$" },
    "run_id": { "type": "string", "minLength": 1 },
    "entries": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "secret_id",
          "service",
          "provider",
          "handle_name",
          "location_class",
          "allowed_roles",
          "allowed_scopes",
          "owner_gate",
          "rotation_status",
          "last_verified_at",
          "validation_method",
          "redaction_proof"
        ],
        "properties": {
          "secret_id": { "type": "string", "minLength": 1 },
          "service": { "type": "string", "minLength": 1 },
          "provider": { "type": "string", "minLength": 1 },
          "handle_name": { "type": "string", "minLength": 1 },
          "location_class": { "type": "string", "minLength": 1 },
          "allowed_roles": { "type": "array", "items": { "type": "string" }, "minItems": 1 },
          "allowed_scopes": { "type": "array", "items": { "type": "string" }, "minItems": 1 },
          "owner_gate": { "type": "string", "enum": ["none", "owner_credential_required", "owner_rotation_required"] },
          "rotation_status": { "type": "string", "enum": ["unknown", "current", "rotation_required", "revoked"] },
          "last_verified_at": { "type": ["string", "null"], "format": "date-time" },
          "validation_method": { "type": "string", "minLength": 1 },
          "redaction_proof": { "type": "string", "enum": ["metadata_only", "scanner_pass", "manual_redacted"] }
        }
      }
    }
  }
}
