{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agenthub.local/schemas/agenthub_validator_execution_authority_envelope.schema.json",
  "title": "AgentHub Validator Execution Authority Envelope",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "run_id",
    "task_id",
    "scope_signature",
    "validator_name",
    "validator_path",
    "execution_route",
    "route_lane",
    "decision",
    "same_blocker_count",
    "routine_blocker",
    "live_worker_missing",
    "owner_only",
    "forbidden_scope",
    "destructive_action"
  ],
  "properties": {
    "run_id": { "type": "string", "minLength": 1 },
    "task_id": { "type": "string", "minLength": 1 },
    "scope_signature": { "type": "string", "minLength": 1 },
    "validator_name": { "type": "string", "minLength": 1 },
    "validator_path": { "type": "string", "minLength": 1 },
    "execution_route": { "type": "string", "minLength": 1 },
    "route_lane": { "type": "string", "minLength": 1 },
    "decision": {
      "type": "string",
      "enum": [
        "ALLOW",
        "ALLOW_WITH_SCOPED_WORKER",
        "ALLOW_WITH_AUTO_REVIEW",
        "PACKFIX_REQUIRED",
        "ROUTE_REPAIR_REQUIRED",
        "DENY_FORBIDDEN_SCOPE"
      ]
    },
    "same_blocker_count": { "type": "integer", "minimum": 0 },
    "routine_blocker": { "type": "boolean" },
    "live_worker_missing": { "type": "boolean" },
    "owner_only": { "type": "boolean" },
    "owner_approval": { "type": "boolean" },
    "forbidden_scope": { "type": "boolean" },
    "destructive_action": { "type": "boolean" },
    "connector_blockers": {
      "type": "array",
      "items": { "type": "string" }
    },
    "blocker_code": { "type": "string" },
    "error_detail": { "type": "string" }
  }
}
