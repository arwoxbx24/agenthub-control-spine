{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "$id":"https://agenthub.local/schemas/agenthub_microservice_scope_descriptor.schema.json",
  "title":"AgentHub Microservice Scope Descriptor",
  "type":"object",
  "additionalProperties":false,
  "required":["service_name","owner","runtime_surface","dependencies","stateful_resources","allowed_operations","forbidden_operations","rollback_plan","validation_profile"],
  "properties":{
    "service_name":{"type":"string","minLength":1},
    "owner":{"type":"string","minLength":1},
    "runtime_surface":{"type":"array","items":{"type":"string"}},
    "dependencies":{"type":"array","items":{"type":"string"}},
    "stateful_resources":{"type":"array","items":{"type":"string"}},
    "allowed_operations":{"type":"array","items":{"type":"string"}},
    "forbidden_operations":{"type":"array","items":{"type":"string"}},
    "rollback_plan":{"type":"string","minLength":1},
    "validation_profile":{"type":"string","minLength":1}
  }
}
