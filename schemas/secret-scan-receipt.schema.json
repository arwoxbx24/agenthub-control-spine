{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/arwoxbx24/agenthub-control-spine/schemas/secret-scan-receipt.schema.json",
  "title": "AgentHub Secret Scan Receipt",
  "type": "object",
  "required": [
    "run_id",
    "task_id",
    "scope",
    "repositories_covered",
    "tools",
    "redacted_findings_summary",
    "controls_installed",
    "validation",
    "blockers",
    "no_secret_disclosure_attestation"
  ],
  "properties": {
    "run_id": { "type": "string" },
    "task_id": { "type": "string" },
    "scope": { "type": "string" },
    "repositories_covered": {
      "type": "array",
      "items": { "type": "string" }
    },
    "tools": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["name", "version"],
        "properties": {
          "name": { "type": "string" },
          "version": { "type": "string" }
        },
        "additionalProperties": false
      }
    },
    "redacted_findings_summary": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["repo", "finding_count", "rule_ids", "remediation_status"],
        "properties": {
          "repo": { "type": "string" },
          "finding_count": { "type": "integer", "minimum": 0 },
          "rule_ids": {
            "type": "array",
            "items": { "type": "string" }
          },
          "remediation_status": {
            "type": "string",
            "enum": ["none", "review_required", "rotation_required", "rotated", "revoked", "false_positive_approved"]
          }
        },
        "additionalProperties": false,
        "not": {
          "anyOf": [
            { "required": ["secret"] },
            { "required": ["secret_value"] },
            { "required": ["match"] },
            { "required": ["raw"] }
          ]
        }
      }
    },
    "controls_installed": {
      "type": "array",
      "items": { "type": "string" }
    },
    "validation": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["name", "status"],
        "properties": {
          "name": { "type": "string" },
          "status": { "type": "string" },
          "evidence": { "type": "string" }
        },
        "additionalProperties": false
      }
    },
    "blockers": {
      "type": "array",
      "items": { "type": "string" }
    },
    "no_secret_disclosure_attestation": { "type": "boolean", "const": true }
  },
  "additionalProperties": false
}
