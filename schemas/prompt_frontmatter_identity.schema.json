{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "prompt_frontmatter_identity.schema.json",
  "title": "AgentHub Prompt Frontmatter Identity",
  "type": "object",
  "required": ["artifact_id", "artifact_type", "prompt_uid", "prompt_family", "idempotency_key_template", "source_task", "run_id", "scope_signature", "owner_role", "lifecycle_status", "default_load", "safe_to_replay", "created_at"],
  "properties": {
    "artifact_id": {"type": "string", "minLength": 1},
    "artifact_type": {"type": "string", "minLength": 1},
    "prompt_uid": {"type": "string", "minLength": 1},
    "prompt_family": {"type": "string", "minLength": 1},
    "idempotency_key_template": {"type": "string", "pattern": "prompt_uid|\\{prompt_uid\\}"},
    "source_task": {"type": "string", "minLength": 1},
    "run_id": {"type": "string", "minLength": 1},
    "scope_signature": {"type": "string", "minLength": 1},
    "owner_role": {"type": "string", "minLength": 1},
    "lifecycle_status": {"type": "string", "minLength": 1},
    "default_load": {"type": "boolean"},
    "safe_to_replay": {"type": "boolean"},
    "created_at": {"type": "string"}
  },
  "additionalProperties": true
}
