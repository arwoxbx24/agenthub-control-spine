{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agenthub.local/schemas/scope_manifest.schema.json",
  "title": "AgentHub Scope Manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "RUN_ID",
    "task_id",
    "task_class",
    "role",
    "worker_id",
    "product_or_service",
    "objective",
    "READ_ALLOWED_ROOTS",
    "WRITE_ALLOWED_ROOTS",
    "EXEC_ALLOWED_COMMAND_CLASSES",
    "FORBIDDEN_ROOTS",
    "FORBIDDEN_COMMAND_CLASSES",
    "ACTIVE_RUNTIME_PATH_PROOF",
    "OFFICIAL_MECHANISM_DECISION",
    "BACKUP_PLAN",
    "ROLLBACK_PLAN",
    "VALIDATION_PLAN",
    "DYNAMIC_SCOPE_EXPANSION_POLICY",
    "NO_USER_CHAT_POLICY",
    "owner_only_gate_conditions"
  ],
  "properties": {
    "RUN_ID": { "type": "string", "minLength": 1 },
    "task_id": { "type": "string", "minLength": 1 },
    "task_class": { "type": "string", "minLength": 1 },
    "role": { "type": "string", "minLength": 1 },
    "worker_id": { "type": "string", "minLength": 1 },
    "product_or_service": { "type": "string", "minLength": 1 },
    "objective": { "type": "string", "minLength": 1 },
    "READ_ALLOWED_ROOTS": { "type": "array", "items": { "type": "string" } },
    "WRITE_ALLOWED_ROOTS": { "type": "array", "items": { "type": "string" } },
    "EXEC_ALLOWED_COMMAND_CLASSES": { "type": "array", "items": { "type": "string" } },
    "FORBIDDEN_ROOTS": { "type": "array", "items": { "type": "string" }, "minItems": 1 },
    "FORBIDDEN_COMMAND_CLASSES": { "type": "array", "items": { "type": "string" } },
    "ACTIVE_RUNTIME_PATH_PROOF": { "type": "string", "minLength": 1 },
    "OFFICIAL_MECHANISM_DECISION": { "type": "string", "minLength": 1 },
    "BACKUP_PLAN": { "type": "string", "minLength": 1 },
    "ROLLBACK_PLAN": { "type": "string", "minLength": 1 },
    "VALIDATION_PLAN": { "type": "string", "minLength": 1 },
    "DYNAMIC_SCOPE_EXPANSION_POLICY": { "type": "string", "minLength": 1 },
    "NO_USER_CHAT_POLICY": { "type": "string", "minLength": 1 },
    "owner_only_gate_conditions": { "type": "array", "items": { "type": "string" } }
  }
}
