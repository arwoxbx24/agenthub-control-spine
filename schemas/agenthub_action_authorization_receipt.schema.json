{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/arwoxbx24/agenthub-control-spine/schemas/agenthub_action_authorization_receipt.schema.json",
  "title": "AgentHub Action Authorization Receipt",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "receipt_id",
    "run_id",
    "task_id",
    "scope_signature",
    "actor_role",
    "operation",
    "target_surface",
    "allowed_surfaces",
    "forbidden_surfaces",
    "model_route",
    "secrets_policy",
    "rollback_requirement",
    "evidence_target",
    "validation_plan",
    "owner_only_check",
    "decision"
  ],
  "properties": {
    "receipt_id": { "type": "string", "minLength": 8 },
    "run_id": { "type": "string", "minLength": 8 },
    "task_id": { "type": "string", "minLength": 1 },
    "scope_signature": { "type": "string", "minLength": 1 },
    "actor_role": {
      "enum": [
        "T0_CONTROL",
        "T1_ARCHITECT",
        "T2_CODEX_WORKER",
        "T2_DEVOPS_WORKER",
        "T2_REGISTRAR",
        "T2_SECRET_HANDLE_REGISTRAR",
        "VERIFIER",
        "REGISTRAR"
      ]
    },
    "operation": { "type": "string", "minLength": 1 },
    "target_surface": { "type": "string", "minLength": 1 },
    "allowed_surfaces": { "type": "array", "minItems": 1, "items": { "type": "string" } },
    "forbidden_surfaces": { "type": "array", "minItems": 1, "items": { "type": "string" } },
    "model_route": {
      "type": "object",
      "additionalProperties": false,
      "required": ["required_model_class", "selected_model", "route_reason"],
      "properties": {
        "required_model_class": { "type": "string", "minLength": 1 },
        "selected_model": { "type": "string", "minLength": 1 },
        "route_reason": { "type": "string", "minLength": 1 },
        "codex_available": { "type": "boolean" },
        "same_run_fallback": { "type": "boolean" },
        "fallback_receipt": { "type": "string", "minLength": 1 }
      }
    },
    "secrets_policy": { "enum": ["metadata_only", "no_secret_access", "owner_only_secret_required"] },
    "rollback_requirement": { "enum": ["none", "git_branch", "runtime_rollback_plan", "owner_gate_required"] },
    "evidence_target": { "type": "string", "minLength": 1 },
    "validation_plan": { "type": "array", "minItems": 1, "items": { "type": "string" } },
    "owner_only_check": { "enum": ["not_required", "required", "blocked_owner_only"] },
    "decision": {
      "enum": [
        "ALLOW_CONTROL_ROUTE",
        "ALLOW_POLICY_ARCHITECTURE",
        "ALLOW_CODEX_AUTHORIZED_WORKER",
        "ALLOW_REGISTRAR_PATCH",
        "ALLOW_SECRET_HANDLE_METADATA",
        "ALLOW_READONLY_VERIFY",
        "BLOCKED_T0_DIRECT_RUNTIME_ACTION",
        "BLOCKED_T0_DIRECT_AUTHORSHIP",
        "POLICY_DEFECT_CAPABILITY_FIELDS_MISSING",
        "MODEL_ROUTE_DEFECT",
        "MODEL_FALLBACK_DEFECT",
        "OWNER_ONLY_GATE"
      ]
    }
  }
}
