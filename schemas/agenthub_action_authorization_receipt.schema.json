{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "agenthub_action_authorization_receipt",
  "type": "object",
  "additionalProperties": true,
  "properties": {
    "allowed": { "type": "boolean" },
    "allow": { "type": "boolean" },
    "lane": {
      "type": "integer",
      "minimum": 0,
      "maximum": 6
    },
    "lane_name": { "type": "string" },
    "gate": { "type": "string" },
    "blocker": { "type": ["string", "null"] },
    "detail": { "type": "string" },
    "repair": {
      "type": ["object", "null"],
      "additionalProperties": true,
      "properties": {
        "action": { "type": "string" },
        "one_retry": { "type": "boolean" },
        "retry_count": { "type": "integer" },
        "repair_action": { "type": "string" }
      }
    },
    "retry_limit_reached": { "type": "boolean" },
    "required_validation": { "type": "string" },
    "control_spine_authority": { "type": "boolean" },
    "schema": { "type": "string" },
    "evidence": { "type": "object", "additionalProperties": true },
    "role": { "type": "string" },
    "scope": { "type": ["string", "null"] },
    "task_id": { "type": ["string", "null"] },
    "run_id": { "type": ["string", "null"] },
    "lane6_destruction_proof": { "$ref": "./agenthub_lane6_destruction_proof.schema.json" }
  },
  "required": ["allowed", "allow", "lane", "gate", "blocker"]
}
