{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agenthub.local/schemas/test_acceptance_proof.schema.json",
  "title": "Test acceptance proof",
  "type": "object",
  "required": ["test_url", "role_or_account_type", "actions", "expected_results", "proof_type", "test_only_statement", "accepted"],
  "properties": {
    "test_url": {"type": "string", "minLength": 1},
    "role_or_account_type": {"type": "string", "minLength": 1},
    "actions": {"type": "array", "minItems": 1, "maxItems": 3, "items": {"type": "string"}},
    "expected_results": {"type": "array", "minItems": 1, "items": {"type": "string"}},
    "proof_type": {"enum": ["browser_trace", "screenshot", "video", "owner_text", "recorded_session"]},
    "test_only_statement": {"const": true},
    "accepted": {"type": "boolean"}
  },
  "additionalProperties": false
}
