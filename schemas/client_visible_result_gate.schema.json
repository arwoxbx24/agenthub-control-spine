  "$id": "https://agenthub.local/schemas/client_visible_result_gate.schema.json",
  "title": "Client visible result gate",
  "type": "object",
  "required": ["code_ready", "ci_green", "browser_proof", "visible_result", "cleanup_done", "done_allowed"],
