{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agenthub.local/schemas/agenthub-blocker-taxonomy.schema.json",
  "title": "AgentHub Blocker Taxonomy",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "run_id",
    "scope_signature",
    "lane",
    "final_state",
    "blocker_type",
    "evidence_class",
    "evidence_pointer",
    "next_legal_route"
  ],
  "properties": {
    "run_id": { "type": "string", "minLength": 1 },
    "task_id": { "type": "string", "minLength": 1 },
    "scope_signature": { "type": "string", "minLength": 1 },
    "lane": {
      "type": "integer",
      "minimum": 0,
      "maximum": 6
    },
    "lane_name": {
      "type": "string",
      "enum": [
        "owner_communication",
        "control_spine_artifacts",
        "repository_hygiene",
        "task_and_run_self_healing",
        "read_only_live_diagnostic",
        "reversible_runtime_repair",
        "destructive_cleanup"
      ]
    },
    "final_state": {
      "type": "string",
      "enum": [
        "DONE_WITH_EVIDENCE",
        "READY_BLOCKED_BY_PLATFORM_GATE",
        "OWNER_ONLY_DESTRUCTIVE_CONFIRMATION_REQUIRED",
        "NO_APPROVED_WORKER_ROUTE_AFTER_REPAIR",
        "TASK_SERVICE_AND_REPO_RECEIPT_BOTH_UNAVAILABLE",
        "LANE6_PROOF_MISSING",
        "SECRET_EXPOSURE_RISK",
        "GLOBAL_INFRASTRUCTURE_AUTHORITY_MISSING",
        "DUPLICATE_SCOPE_PR_EXISTS"
      ]
    },
    "blocker_type": {
      "type": "string",
      "enum": [
        "none",
        "TASK_CARD_PAYLOAD_REPAIR_REQUIRED",
        "TASK_ID_SELF_HEALING_REQUIRED",
        "RUN_STATE_SELF_HEALING_REQUIRED",
        "MODEL_FALLBACK_RECEIPT_REPAIR_REQUIRED",
        "SHARE_FALLBACK_TO_REPO_ARTIFACT_REQUIRED",
        "STATUS_CONTEXT_MAPPING_REPAIR_REQUIRED",
        "CONTROL_SPINE_AUTHORSHIP_CLASSIFICATION_REPAIR_REQUIRED",
        "WORD_FILTER_PAYLOAD_REWRITE_REQUIRED",
        "PROGRESS_OUTPUT_SUPPRESSED_CONTINUE",
        "OWNER_ONLY_DESTRUCTIVE_CONFIRMATION_REQUIRED",
        "BACKUP_OR_REPLACEMENT_PROOF_REQUIRED",
        "UNKNOWN_PRODUCTION_DATA_RISK",
        "SECRET_EXPOSURE_RISK",
        "BROAD_INFRASTRUCTURE_MUTATION_NOT_AUTHORIZED",
        "NO_SCOPED_T2_ROUTE_FOR_RUNTIME_REPAIR",
        "REPO_LIFECYCLE_INVENTORY_REQUIRED",
        "INSTRUCTION_SOURCE_DRIFT",
        "SCOPE_LANE_CONFLICT",
        "SAME_GATE_LOOP_LIMIT_REACHED"
      ]
    },
    "evidence_class": {
      "type": "string",
      "enum": [
        "VERIFIED_BY_REPO",
        "VERIFIED_BY_YOUTRACK",
        "VERIFIED_BY_AGENTHUB_LEDGER",
        "VERIFIED_BY_RUNTIME_WORKER",
        "USER_REPORTED_NOT_VERIFIED",
        "HYPOTHESIS",
        "CONTRADICTED"
      ]
    },
    "evidence_pointer": { "type": "string", "minLength": 1 },
    "next_legal_route": { "type": "string", "minLength": 1 },
    "same_gate_attempt_count": { "type": "integer", "minimum": 0, "maximum": 2 },
    "self_healed": { "type": "boolean", "default": false },
    "terminal_after_repairs_exhausted": { "type": "boolean", "default": false }
  },
  "allOf": [
    {
      "if": { "properties": { "blocker_type": { "const": "none" } } },
      "then": {
        "properties": {
          "final_state": { "const": "DONE_WITH_EVIDENCE" },
          "terminal_after_repairs_exhausted": { "const": false }
        }
      }
    }
  ]
}
