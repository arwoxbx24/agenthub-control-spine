{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "agenthub_blocker_taxonomy",
  "type": "object",
  "additionalProperties": true,
  "properties": {
    "blocker": {
      "type": "string",
      "enum": [
        "TASK_CARD_PAYLOAD_REPAIR_REQUIRED",
        "TASK_ID_SELF_HEALING_REQUIRED",
        "RUN_STATE_SELF_HEALING_REQUIRED",
        "MODEL_FALLBACK_RECEIPT_REPAIR_REQUIRED",
        "SHARE_FALLBACK_TO_REPO_ARTIFACT_REQUIRED",
        "STATUS_CONTEXT_MAPPING_REPAIR_REQUIRED",
        "CONTROL_SPINE_AUTHORSHIP_CLASSIFICATION_REPAIR_REQUIRED",
        "WORD_FILTER_PAYLOAD_REWRITE_REQUIRED",
        "PROGRESS_OUTPUT_SUPPRESSED_CONTINUE",
        "OWNER_APPROVAL_REQUIRED_FOR_DESTRUCTIVE_DELETE",
        "BACKUP_OR_REPLACEMENT_PROOF_REQUIRED",
        "UNKNOWN_PRODUCTION_DATA_RISK",
        "SECRET_EXPOSURE_RISK",
        "BROAD_INFRASTRUCTURE_MUTATION_NOT_AUTHORIZED",
        "NO_SCOPED_T2_ROUTE_FOR_RUNTIME_REPAIR",
        "REPO_LIFECYCLE_INVENTORY_REQUIRED",
        "INSTRUCTION_SOURCE_DRIFT",
        "SCOPE_LANE_CONFLICT",
        "READ_ONLY_DIAGNOSTIC_NOT_BLOCKED_BY_RUNTIME_MUTATION_RULE",
        "SCOPED_T2_RUNTIME_REPAIR_ALLOWED_WHEN_BOUND",
        "CONTROL_SPINE_AUTHORSHIP_ALLOWED",
        "TASK_PAYLOAD_MISSING_REQUIRED_FIELDS",
        "PRE_DISPATCH_TASK_GATE_MISSING_ISSUE_ID",
        "DISPATCH_TASK_GATE_MISSING",
        "MODEL_FALLBACK_RECEIPT_MISSING",
        "PHYSICAL_TASK_WRITE_MISSING",
        "CONTRACT_ONLY_RUNTIME_LIVE_DISPATCH_BLOCKED",
        "T0_DIRECT_AUTHORSHIP_DEFECT",
        "PASS"
      ]
    },
    "lane": { "type": "integer", "minimum": 0, "maximum": 6 },
    "scope": { "type": "string" },
    "severity": { "type": "string", "enum": ["info", "warn", "block", "terminal"] },
    "message": { "type": "string" },
    "metadata": { "type": "object", "additionalProperties": true }
  },
  "required": ["blocker"]
}
