{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "agenthub-global-control-receipt.schema.json",
  "title": "AgentHub Global Control Receipt",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "task_id",
    "run_id",
    "source_reports",
    "role_gate",
    "worker_gate",
    "blocker_matrix_gate",
    "evidence_loop_gate",
    "done_taxonomy_gate",
    "no_repeat_gate",
    "validation_refs",
    "forbidden_scope_confirmation",
    "final_state"
  ],
  "properties": {
    "task_id": { "type": ["string", "null"] },
    "run_id": { "type": "string", "minLength": 1 },
    "worker_id": { "type": ["string", "null"] },
    "source_reports": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "minLength": 1 }
    },
    "role_gate": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "mode"],
      "properties": {
        "status": { "enum": ["PASS", "BLOCKED_T0_DIRECT_AUTHORSHIP"] },
        "mode": {
          "enum": [
            "governance_only_scope",
            "worker_ownership_receipt",
            "fallback_worker_receipt"
          ]
        },
        "receipt_ref": { "type": "string" }
      }
    },
    "worker_gate": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status"],
      "properties": {
        "status": { "enum": ["PASS", "WORKER_ROUTE_UNAVAILABLE", "not_required"] },
        "worker_id": { "type": ["string", "null"] },
        "allowed_surface": {
          "type": "array",
          "items": { "type": "string" }
        },
        "forbidden_surface": {
          "type": "array",
          "items": { "type": "string" }
        }
      }
    },
    "blocker_matrix_gate": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "alternatives_evaluated"],
      "properties": {
        "status": { "enum": ["PASS", "BLOCKER_MATRIX_NOT_EVALUATED"] },
        "alternatives_evaluated": {
          "type": "array",
          "items": {
            "enum": [
              "route_repair",
              "scope_split",
              "alternate_validation",
              "ready_made_helper",
              "typed_waiver",
              "child_fix",
              "true_terminal_blocker"
            ]
          }
        }
      }
    },
    "evidence_loop_gate": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status"],
      "properties": {
        "status": { "enum": ["PASS", "BLOCKED_DONE_EVIDENCE_MISSING"] },
        "microtasks_created": {
          "type": "array",
          "items": { "type": "string" }
        }
      }
    },
    "done_taxonomy_gate": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "done_type"],
      "properties": {
        "status": { "enum": ["PASS", "DONE_TAXONOMY_MISMATCH"] },
        "done_type": {
          "enum": [
            "GOVERNANCE_DONE",
            "TASK_SERVICE_DONE",
            "SANDBOX_PROOF_DONE",
            "CLIENT_DELIVERY_DONE",
            "PRODUCTION_E2E_DONE",
            "RUNTIME_HEALTH_GREEN_ONLY",
            "BLOCKED"
          ]
        }
      }
    },
    "hot_lane_gate": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status"],
      "properties": {
        "status": { "enum": ["PASS", "HOT_LANE_CLASSIFICATION_MISSING", "not_applicable"] },
        "ledger_ref": { "type": "string" }
      }
    },
    "no_repeat_gate": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "same_gate_retry_count"],
      "properties": {
        "status": { "enum": ["PASS", "REPEATED_GATE_LOOP"] },
        "same_gate_retry_count": { "type": "integer", "minimum": 0 }
      }
    },
    "validation_refs": {
      "type": "array",
      "items": { "type": "string" }
    },
    "forbidden_scope_confirmation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "statement"],
      "properties": {
        "status": { "enum": ["PASS", "FORBIDDEN_RUNTIME_SURFACE_TOUCHED"] },
        "statement": { "type": "string", "minLength": 1 }
      }
    },
    "final_state": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status"],
      "properties": {
        "status": {
          "enum": [
            "DONE",
            "BLOCKED",
            "PARTIAL",
            "CONTROL_REPAIR_RECORDED"
          ]
        },
        "primary_blocker": {
          "enum": [
            "CANONICAL_REPO_UNAVAILABLE",
            "SOURCE_READ_INCOMPLETE",
            "CONTROL_PLANE_ROUTE_UNAVAILABLE",
            "WORKER_ROUTE_UNAVAILABLE",
            "DUPLICATE_CONTROL_ARTIFACT_RISK",
            "BLOCKED_T0_DIRECT_AUTHORSHIP",
            "BLOCKER_MATRIX_NOT_EVALUATED",
            "DONE_TAXONOMY_MISMATCH",
            "BLOCKED_DONE_EVIDENCE_MISSING",
            "HOT_LANE_CLASSIFICATION_MISSING",
            "REPEATED_GATE_LOOP",
            "TASK_SERVICE_PAYLOAD_CONTRACT_UNRESOLVED",
            "SECRET_OR_TRANSCRIPT_RISK",
            "INDEX_UPDATE_MISSING",
            "CHANGELOG_UPDATE_MISSING",
            "SCHEMA_VALIDATION_FAILED",
            "GITHUB_PUSH_OR_PR_BLOCKED",
            "FORBIDDEN_RUNTIME_SURFACE_TOUCHED",
            "RECEIPT_INCOMPLETE"
          ]
        }
      }
    }
  }
}
