{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "user_outcome_validation_matrix.schema.json",
  "title": "AgentHub User Outcome Validation Matrix",
  "type": "object",
  "required": ["task_id", "run_id", "scope_signature", "rows", "done_tuple"],
  "properties": {
    "task_id": {"type": "string", "pattern": "^[A-Z]+-[0-9]+$"},
    "run_id": {"type": "string", "minLength": 1},
    "scope_signature": {"type": "string", "minLength": 1},
    "rows": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["name", "in_scope", "reason", "evidence_status"],
        "properties": {
          "name": {"type": "string"},
          "in_scope": {"type": "boolean"},
          "reason": {"type": "string"},
          "evidence_status": {"type": "string", "enum": ["PASS", "NOT_APPLICABLE", "DEFECT", "BLOCKED"]},
          "evidence": {"type": "string"},
          "blocker_type": {"type": "string"}
        },
        "additionalProperties": false
      }
    },
    "user_visible_scope": {"type": "boolean"},
    "browser_user_story_required": {"type": "boolean"},
    "done_tuple": {
      "type": "object",
      "required": ["implementation_evidence", "validation_evidence", "receipt", "blocker"],
      "properties": {
        "implementation_evidence": {"type": "string", "minLength": 1},
        "validation_evidence": {"type": "string", "minLength": 1},
        "receipt": {"type": "string", "minLength": 1},
        "blocker": {"type": "string", "const": "none"}
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
