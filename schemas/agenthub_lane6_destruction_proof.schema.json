{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "agenthub_lane6_destruction_proof",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "object_identity": { "type": "string" },
    "object_type": { "type": "string", "enum": ["container", "image", "volume", "database", "service", "module"] },
    "environment_class": { "type": "string", "enum": ["production", "staging", "test", "scratch", "unknown"] },
    "owner_approved": { "type": "boolean" },
    "replacement_proven": { "type": "boolean" },
    "backup_verified": { "type": "boolean" },
    "no_backup_approved": { "type": "boolean" },
    "replacement_receipt": { "type": "string" },
    "dependency_scan_receipt": { "type": "string" },
    "deletion_receipt": { "type": "string" },
    "backup_artifact": { "type": "string" },
    "secret_risk": { "type": "boolean" },
    "broad_scope": { "type": "boolean" },
    "lane6": {
      "type": "object",
      "properties": {
        "owner_approved": { "type": "boolean" },
        "replacement_proven": { "type": "boolean" },
        "backup_verified": { "type": "boolean" },
        "test_approved": { "type": "boolean" }
      },
      "required": ["owner_approved", "replacement_proven", "backup_verified"]
    }
  },
  "required": ["object_identity", "environment_class", "lane6"]
}
