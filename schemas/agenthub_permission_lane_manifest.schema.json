{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agenthub.local/schemas/agenthub_permission_lane_manifest.schema.json",
  "title": "AgentHub Permission Lane Manifest",
  "type": "object",
  "additionalProperties": false,
  "required": ["run_id", "task_id", "lane", "role", "allowed_surfaces", "forbidden_surfaces", "evidence", "expiry", "receipt_path"],
  "properties": {
    "run_id": { "type": "string", "minLength": 1 },
    "task_id": { "type": "string", "pattern": "^[A-Z]+-[0-9]+$" },
    "lane": { "type": "integer", "minimum": 0, "maximum": 6 },
    "role": { "type": "string", "minLength": 1 },
    "allowed_surfaces": { "type": "array", "items": { "type": "string" }, "minItems": 1 },
    "forbidden_surfaces": { "type": "array", "items": { "type": "string" }, "minItems": 1 },
    "rollback": { "type": "string" },
    "evidence": { "type": "string", "minLength": 1 },
    "expiry": { "type": "string", "minLength": 1 },
    "receipt_path": { "type": "string", "minLength": 1 }
  }
}
