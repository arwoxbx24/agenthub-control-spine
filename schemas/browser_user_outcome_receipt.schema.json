{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agenthub.local/schemas/browser_user_outcome_receipt.schema.json",
  "title": "Browser User Outcome Receipt",
  "type": "object",
  "additionalProperties": true,
  "required": [
    "task_id",
    "run_id",
    "url",
    "checked_at",
    "browser_engine",
    "viewport",
    "status_code",
    "content_type",
    "title",
    "visible_text_markers",
    "dom_root_non_empty",
    "screenshot_path",
    "screenshot_sha256",
    "console_errors",
    "failed_network_requests",
    "critical_assets",
    "api_checks",
    "auth_flow_status",
    "user_outcome_status",
    "evidence_quality_label",
    "blocker"
  ],
  "properties": {
    "task_id": {"type": "string", "minLength": 1},
    "run_id": {"type": "string", "minLength": 1},
    "url": {"type": "string", "minLength": 1},
    "checked_at": {"type": "string"},
    "browser_engine": {"type": "string", "minLength": 1},
    "viewport": {"type": "string", "minLength": 1},
    "status_code": {"type": "integer"},
    "content_type": {"type": "string"},
    "title": {"type": "string"},
    "visible_text_markers": {"type": "array", "items": {"type": "string"}},
    "dom_root_non_empty": {"type": "boolean"},
    "screenshot_path": {"type": ["string", "null"]},
    "screenshot_sha256": {"type": ["string", "null"]},
    "console_errors": {"type": "array"},
    "failed_network_requests": {"type": "array"},
    "critical_assets": {"type": "array"},
    "api_checks": {"type": "array"},
    "auth_flow_status": {"enum": ["PASS", "LOGIN_SCREEN_ONLY", "NOT_REQUIRED", "FAIL", "BLOCKED"]},
    "user_outcome_status": {"enum": ["PASS", "NOT_PROVEN", "FAIL", "BLOCKED"]},
    "evidence_quality_label": {"enum": ["BACKEND_ONLY", "HTML_SHELL_ONLY", "ASSETS_ONLY", "BROWSER_RENDERED", "USER_FLOW_VALIDATED", "KOMODO_USER_OUTCOME_VALIDATED"]},
    "blocker": {"type": ["string", "null"]}
  }
}
