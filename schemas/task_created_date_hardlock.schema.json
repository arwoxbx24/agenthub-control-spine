{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "task_created_date_hardlock.schema.json",
  "title": "AgentHub Task Created Date Hardlock",
  "type": "object",
  "required": ["task_id", "run_id", "created_at", "custom_created_date", "decision"],
  "properties": {
    "task_id": {"type": "string", "pattern": "^[A-Z]+-[0-9]+$"},
    "run_id": {"type": "string", "minLength": 1},
    "created_at": {"type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2} [0-9]{2}:[0-9]{2}:[0-9]{2}$"},
    "custom_created_date": {"type": "string", "minLength": 1},
    "source": {"type": "string", "enum": ["post_create_readback", "backfill_from_createdAt", "manual_verified"]},
    "decision": {"type": "string", "enum": ["PASS", "BACKFILL_REQUIRED", "BLOCKED_TASK_DATE_MISSING", "BLOCKED_DATE_MISMATCH"]},
    "receipt": {"type": "string"}
  },
  "additionalProperties": false
}
