{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "task-service-payload-builder-contract.schema.json",
  "title": "Task-Service Payload Builder Contract",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "builder",
    "sid",
    "tid",
    "eid",
    "wid",
    "task_id",
    "run_id",
    "worker_id",
    "scope",
    "duplicate_signature",
    "route_receipt_refs",
    "evidence_refs",
    "validation_refs",
    "full_card_fields"
  ],
  "properties": {
    "builder": {
      "enum": [
        "build_done_payload",
        "build_blocker_payload",
        "build_attach_evidence_payload",
        "build_transition_payload"
      ]
    },
    "sid": { "type": "string", "minLength": 1 },
    "tid": { "type": "string", "minLength": 1 },
    "eid": { "type": "string", "minLength": 1 },
    "wid": { "type": "string", "minLength": 1 },
    "task_id": { "type": "string", "minLength": 1 },
    "run_id": { "type": "string", "minLength": 1 },
    "worker_id": { "type": "string", "minLength": 1 },
    "scope": {
      "type": "object",
      "additionalProperties": false,
      "required": ["allowed", "forbidden"],
      "properties": {
        "allowed": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string" }
        },
        "forbidden": {
          "type": "array",
          "items": { "type": "string" }
        }
      }
    },
    "duplicate_signature": { "type": "string", "minLength": 1 },
    "route_receipt_refs": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "minLength": 1 }
    },
    "evidence_refs": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 }
    },
    "validation_refs": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 }
    },
    "target_stage": { "type": "string" },
    "blocker_class": { "type": "string" },
    "full_card_fields": {
      "type": "object",
      "additionalProperties": true,
      "required": [
        "russian_title",
        "repository",
        "github_branch",
        "task_type",
        "what_do",
        "solution_2_3_sentences",
        "labels",
        "tags",
        "expected_validation",
        "implementation_evidence_policy",
        "validation_evidence_policy",
        "done_gate_policy",
        "blocker_policy"
      ],
      "properties": {
        "russian_title": { "type": "string", "minLength": 1 },
        "repository": { "type": "string", "minLength": 1 },
        "github_branch": { "type": "string", "minLength": 1 },
        "task_type": { "enum": ["Incident", "Bug", "Task", "Research"] },
        "what_do": { "type": "string", "minLength": 1 },
        "solution_2_3_sentences": { "type": "string", "minLength": 1 },
        "labels": {
          "type": "array",
          "items": { "type": "string" }
        },
        "tags": {
          "type": "array",
          "items": { "type": "string" }
        },
        "expected_validation": {
          "type": "array",
          "items": { "type": "string" }
        },
        "implementation_evidence_policy": { "type": "string", "minLength": 1 },
        "validation_evidence_policy": { "type": "string", "minLength": 1 },
        "done_gate_policy": { "type": "string", "minLength": 1 },
        "blocker_policy": { "type": "string", "minLength": 1 }
      }
    },
    "same_gate_retry_count": { "type": "integer", "minimum": 0, "maximum": 2 }
  },
  "allOf": [
    {
      "if": { "properties": { "builder": { "const": "build_blocker_payload" } } },
      "then": { "required": ["blocker_class"] }
    },
    {
      "if": { "properties": { "builder": { "const": "build_transition_payload" } } },
      "then": { "required": ["target_stage"] }
    },
    {
      "if": { "properties": { "builder": { "const": "build_done_payload" } } },
      "then": { "properties": { "target_stage": { "const": "Done" } } }
    }
  ]
}
