{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agenthub.local/schemas/agenthub_model_execution_truth.schema.json",
  "title": "AgentHub Model Execution Truth Receipt",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "run_id",
    "task_id",
    "task_class",
    "route_lane",
    "requested_model",
    "resolved_model",
    "actual_model",
    "first_attempt_model",
    "actual_model_proof_type",
    "actual_model_proof_ref",
    "env_only_model_claim",
    "model_truth_status",
    "usage_audit_access",
    "final_state",
    "model_escalation_receipt"
  ],
  "properties": {
    "run_id": { "type": "string", "minLength": 1 },
    "task_id": { "type": "string", "minLength": 1 },
    "task_class": { "type": "string", "minLength": 1 },
    "route_lane": { "type": "string", "enum": ["M0", "M1", "M2", "M3"] },
    "requested_model": { "type": "string" },
    "resolved_model": { "type": "string" },
    "actual_model": { "type": "string" },
    "first_attempt_model": { "type": "string" },
    "actual_model_proof_type": {
      "type": "string",
      "enum": [
        "codex_compliance_api_event",
        "codex_usage_delta",
        "codex_client_session_metadata",
        "codex_cli_json_event_with_model",
        "codex_remote_app_server_trace",
        "api_response_metadata",
        "fallback_model_receipt",
        "not_available"
      ]
    },
    "actual_model_proof_ref": { "type": "string", "minLength": 0 },
    "env_only_model_claim": { "type": "boolean" },
    "model_truth_status": { "type": "string", "enum": ["PROVEN", "NOT_PROVEN", "BLOCKED_AUDIT_ACCESS", "FALLBACK_PROVEN"] },
    "usage_audit_access": { "type": "boolean" },
    "final_state": { "type": "string", "enum": ["INTERMEDIATE", "PASS", "DONE", "BLOCKED"] },
    "spark_catalog_visible": { "type": "boolean" },
    "model_escalation_receipt": { "type": "string" },
    "fallback_used": { "type": "boolean" },
    "fallback_model": { "type": "string" },
    "fallback_reason": { "type": "string" }
  }
}
