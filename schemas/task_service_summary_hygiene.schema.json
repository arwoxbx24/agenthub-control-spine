{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agenthub.local/schemas/task_service_summary_hygiene.schema.json",
  "title": "Task Service Summary Hygiene",
  "type": "object",
  "additionalProperties": false,
  "required": ["task_id", "summary", "stage", "task_class", "implementation_evidence", "validation_evidence", "receipt", "blocker"],
  "properties": {
    "task_id": { "type": "string", "pattern": "^[A-Z][A-Z0-9]+-[0-9]+$" },
    "summary": { "type": "string", "minLength": 8, "maxLength": 180 },
    "stage": { "type": "string", "enum": ["Backlog", "Develop", "Review", "Test", "Done", "Idea"] },
    "task_class": { "type": "string", "enum": ["Task", "Bug", "Incident", "Research"] },
    "parent_task_id": { "type": "string" },
    "duplicate_signature": { "type": "string" },
    "implementation_evidence": { "type": "boolean" },
    "validation_evidence": { "type": "boolean" },
    "receipt": { "type": "boolean" },
    "blocker": { "type": "string" }
  }
}
