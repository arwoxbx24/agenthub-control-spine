{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "service-dependency-graph.schema.json",
  "title": "AgentHub Service Dependency Graph",
  "type": "object",
  "additionalProperties": false,
  "required": ["graph_id", "created_at", "services"],
  "properties": {
    "graph_id": { "type": "string", "minLength": 1 },
    "created_at": { "type": "string", "format": "date-time" },
    "services": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "upstream_id",
          "project_or_service_owner",
          "runtime_owner_ref",
          "container_name",
          "internal_socket",
          "external_public_socket",
          "dependency_containers",
          "health_probe",
          "restart_policy",
          "forbidden_zones",
          "rollback_action",
          "last_validated_timestamp",
          "proof_source"
        ],
        "properties": {
          "upstream_id": { "type": "string", "minLength": 1 },
          "project_or_service_owner": { "type": "string", "minLength": 1 },
          "runtime_owner_ref": {
            "type": "object",
            "additionalProperties": false,
            "required": ["kind", "ref"],
            "properties": {
              "kind": { "enum": ["compose_path", "systemd_unit", "managed_service", "unknown"] },
              "ref": { "type": "string", "minLength": 1 }
            }
          },
          "container_name": { "type": ["string", "null"] },
          "internal_socket": { "type": "string", "minLength": 1 },
          "external_public_socket": { "type": ["string", "null"] },
          "dependency_containers": {
            "type": "array",
            "items": { "type": "string" }
          },
          "health_probe": {
            "type": "object",
            "additionalProperties": false,
            "required": ["kind", "target", "expected"],
            "properties": {
              "kind": { "enum": ["http", "tcp", "command", "manual"] },
              "target": { "type": "string", "minLength": 1 },
              "expected": { "type": "string", "minLength": 1 }
            }
          },
          "restart_policy": { "type": "string", "minLength": 1 },
          "forbidden_zones": {
            "type": "array",
            "items": { "type": "string" }
          },
          "rollback_action": { "type": "string", "minLength": 1 },
          "last_validated_timestamp": { "type": ["string", "null"], "format": "date-time" },
          "proof_source": { "type": "string", "minLength": 1 }
        }
      }
    }
  }
}
