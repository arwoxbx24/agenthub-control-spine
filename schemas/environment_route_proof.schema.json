{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "environment_route_proof.schema.json",
  "title": "Environment Route Proof",
  "type": "object",
  "required": ["task_id", "run_id", "repo", "branch", "environment", "agenthub_route", "proof_status"],
  "properties": {
    "task_id": { "type": "string", "pattern": "^[A-Z][A-Z0-9]+-[0-9]+$" },
    "run_id": { "type": "string", "minLength": 1 },
    "repo": { "type": "string", "minLength": 1 },
    "branch": { "type": "string", "minLength": 1 },
    "environment": {
      "enum": ["LOCAL_ONLY", "TEST_SERVER", "STAGING", "PRODUCTION", "PROD_RISK_UNKNOWN", "ARCHIVED_REMOTE", "READ_ONLY_REMOTE", "WORKFLOW_SIDE_EFFECT_UNKNOWN"]
    },
    "agenthub_route": { "type": "boolean" },
    "local_prompt_index_used_as_implementation": { "type": "boolean" },
    "proof_status": { "enum": ["PASS", "BLOCKED", "MISSING"] }
  },
  "additionalProperties": false
}

