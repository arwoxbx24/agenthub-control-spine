{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agenthub.local/schemas/technical_assignment.schema.json",
  "title": "AgentHub Technical Assignment",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "assignment_id",
    "run_id",
    "task_id",
    "problem_statement",
    "business_outcome",
    "system_boundaries",
    "affected_components",
    "non_goals",
    "role_matrix",
    "selected_skills",
    "forbidden_skills",
    "allowed_tools",
    "forbidden_tools",
    "source_of_truth",
    "execution_order",
    "rollback_checkpoint",
    "validation_matrix",
    "security_validation",
    "acceptance_gates",
    "evidence_format",
    "final_format"
  ],
  "properties": {
    "assignment_id": { "type": "string", "minLength": 1 },
    "run_id": { "type": "string", "minLength": 1 },
    "task_id": { "type": "string", "minLength": 1 },
    "problem_statement": { "type": "string", "minLength": 1 },
    "business_outcome": { "type": "string", "minLength": 1 },
    "system_boundaries": { "type": "array", "items": { "type": "string" }, "minItems": 1 },
    "affected_components": { "type": "array", "items": { "type": "string" }, "minItems": 1 },
    "non_goals": { "type": "array", "items": { "type": "string" } },
    "role_matrix": { "type": "object" },
    "selected_skills": { "type": "array", "items": { "type": "string" }, "minItems": 1 },
    "forbidden_skills": { "type": "array", "items": { "type": "string" } },
    "allowed_tools": { "type": "array", "items": { "type": "string" } },
    "forbidden_tools": { "type": "array", "items": { "type": "string" } },
    "source_of_truth": { "type": "array", "items": { "type": "string" }, "minItems": 1 },
    "documentation_refs": { "type": "array", "items": { "type": "string" } },
    "execution_order": { "type": "array", "items": { "type": "string" }, "minItems": 1 },
    "rollback_checkpoint": { "type": "string", "minLength": 1 },
    "validation_matrix": { "type": "array", "items": { "type": "string" }, "minItems": 1 },
    "security_validation": { "type": "string", "minLength": 1 },
    "acceptance_gates": { "type": "array", "items": { "type": "string" }, "minItems": 1 },
    "evidence_format": { "type": "string", "minLength": 1 },
    "final_format": { "type": "string", "minLength": 1 }
  }
}
