{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "$id":"https://agenthub.local/schemas/agenthub_secret_handle_resolution.schema.json",
  "title":"AgentHub Secret Handle Resolution",
  "type":"object",
  "additionalProperties":false,
  "required":["task_id","run_id","service","registry_checked","prior_receipts_checked","handle_exists","raw_secret_exposed","result"],
  "properties":{
    "task_id":{"type":"string","minLength":1},
    "run_id":{"type":"string","minLength":1},
    "service":{"type":"string","minLength":1},
    "registry_checked":{"type":"boolean"},
    "prior_receipts_checked":{"type":"boolean"},
    "handle_exists":{"type":"boolean"},
    "allowed_consumer":{"type":"string"},
    "raw_secret_exposed":{"type":"boolean"},
    "result":{"type":"string","enum":["HANDLE_FOUND","HANDLE_MISSING","OWNER_ONLY_REQUIRED","FAIL"]}
  }
}
