{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agenthub.local/schemas/owner_message_classification.schema.json",
  "title": "Owner Message Classification",
  "type": "object",
  "required": ["message", "classification", "risk_level"],
  "additionalProperties": false,
  "properties": {
    "message": {"type": "string", "minLength": 1},
    "classification": {"type": "string", "enum": ["SAFE_DIRECT_ACTION", "NEEDS_SCOPE_NARROWING", "EMOTIONAL_INCIDENT_SIGNAL", "UNSAFE_OR_HARMFUL_REQUEST", "CONFLICTS_WITH_PROJECT_HIERARCHY", "PRODUCTION_OR_IRREVERSIBLE_GATE", "BROAD_PERMISSION_REQUEST", "COMMUNICATION_PREFERENCE", "EVIDENCE_OR_LINK_FACT_CLAIM", "AMBIGUOUS_TASK_DATA"]},
    "risk_level": {"type": "string", "enum": ["LOW", "MEDIUM", "HIGH", "CRITICAL"]},
    "owner_claim_is_proof": {"type": "boolean"},
    "requires_rejection": {"type": "boolean"},
    "requires_scope_lane": {"type": "boolean"}
  }
}
