{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agenthub.local/schemas/microservice_descriptor.schema.json",
  "title": "Microservice Descriptor",
  "type": "object",
  "additionalProperties": false,
  "required": ["service_id", "owner", "runtime", "data_class", "dependencies", "allowed_probes"],
  "properties": {
    "service_id": { "type": "string" },
    "owner": { "type": "string" },
    "runtime": { "type": "string" },
    "ports": { "type": "array", "items": { "type": "string" } },
    "domains": { "type": "array", "items": { "type": "string" } },
    "data_class": { "type": "string" },
    "dependencies": { "type": "array", "items": { "type": "string" } },
    "allowed_probes": { "type": "array", "items": { "type": "string" } }
  }
}
