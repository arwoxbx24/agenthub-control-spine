{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "agenthub_same_run_packfix_no_intermediate_closure.schema.json",
  "title": "AgentHub Same-RUN PackFix No-Intermediate Closure Fixture",
  "type": "object",
  "required": ["cases"],
  "properties": {
    "cases": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "input", "expected"],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "input": {
            "type": "object",
            "required": ["terminal_state"],
            "properties": {
              "terminal_state": { "type": "string" },
              "routine_blocker": { "type": "string" },
              "packfix_created": { "type": "boolean" },
              "packfix_closed": { "type": "boolean" },
              "implementation_evidence": { "type": "boolean" },
              "validation_evidence": { "type": "boolean" },
              "receipt": { "type": "boolean" },
              "task_graph_done": { "type": "boolean" },
              "done_gate": { "type": "boolean" },
              "final_output": { "type": "string" },
              "owner_only_probe_complete": { "type": "boolean" },
              "forbidden_scope": { "type": "boolean" },
              "duplicate_replay": { "type": "boolean" },
              "residual_open": { "type": "boolean" }
            },
            "additionalProperties": false
          },
          "expected": { "type": "string" }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
