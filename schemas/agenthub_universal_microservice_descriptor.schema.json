{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "agenthub_universal_microservice_descriptor.schema.json",
  "title": "AgentHub Universal Microservice Descriptor",
  "type": "object",
  "required": ["service_id", "project_root", "component_type", "task_id", "run_id", "allowed_operations", "forbidden_operations", "required_evidence"],
  "properties": {
    "service_id": {"type": "string", "minLength": 1},
    "human_name": {"type": "string"},
    "project_root": {"type": "string", "minLength": 1},
    "component_type": {"type": "string", "enum": ["docker_compose", "docker_container", "linux_service", "web_ui", "api_service", "database", "queue", "object_storage", "reverse_proxy", "scheduler", "worker", "task_service", "validator", "model_router", "other"]},
    "runtime_kind": {"type": "string"},
    "deployment_kind": {"type": "string"},
    "official_docs_url": {"type": "string"},
    "local_guide_path": {"type": "string"},
    "task_id": {"type": "string", "pattern": "^[A-Z]+-[0-9]+$"},
    "run_id": {"type": "string", "minLength": 1},
    "repo": {"type": "string"},
    "branch": {"type": "string"},
    "vcs_reference": {"type": "string"},
    "owner_task_stage": {"type": "string"},
    "data_surface": {"type": "string"},
    "secret_handle_refs": {"type": "array", "items": {"type": "string"}},
    "auth_surface": {"type": "string"},
    "network_surface": {"type": "string"},
    "ui_surface": {"type": "string"},
    "health_surface": {"type": "string"},
    "rollback_surface": {"type": "string"},
    "allowed_operations": {"type": "array", "items": {"type": "string"}},
    "forbidden_operations": {"type": "array", "items": {"type": "string"}},
    "required_evidence": {"type": "array", "items": {"type": "string"}}
  },
  "additionalProperties": false
}
