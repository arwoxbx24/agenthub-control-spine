{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agenthub.local/schemas/spawned_worker_dispatch.schema.json",
  "title": "Spawned Worker Dispatch",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "event_id",
    "run_id",
    "parent_agent_id",
    "spawned_agent_id",
    "task_id",
    "task_class",
    "role",
    "requested_model",
    "resolved_model",
    "actual_model",
    "model_proof_ref",
    "priority",
    "scope_signature",
    "allowed_scope",
    "forbidden_scope",
    "sandbox_mode",
    "approval_policy",
    "active_skills",
    "forbidden_skills",
    "negative_matches",
    "prompt_hash",
    "started_at",
    "exit_state",
    "evidence_refs",
    "validation_refs",
    "token_budget_estimate",
    "spawned_by",
    "no_user_interruption_proof"
  ],
  "properties": {
    "event_id": { "type": "string", "minLength": 1 },
    "run_id": { "type": "string", "minLength": 1 },
    "parent_agent_id": { "type": "string", "minLength": 1 },
    "spawned_agent_id": { "type": "string", "minLength": 1 },
    "task_id": { "type": "string", "minLength": 1 },
    "task_class": { "type": "string", "minLength": 1 },
    "role": {
      "type": "string",
      "enum": ["T1_ARCHITECT", "T2_CODEX_SPARK_WORKER", "T2_FALLBACK_CODEX_WORKER", "VERIFIER", "REGISTRAR", "READONLY_TRIAGE"]
    },
    "requested_model": { "type": "string", "minLength": 1 },
    "resolved_model": { "type": "string", "minLength": 1 },
    "actual_model": { "type": "string", "minLength": 1 },
    "model_fallback_reason": { "type": ["string", "null"] },
    "model_proof_ref": { "type": "string", "minLength": 1 },
    "priority": { "type": "string", "enum": ["P0", "P1", "P2"] },
    "scope_signature": { "type": "string", "minLength": 1 },
    "allowed_scope": { "type": "array", "items": { "type": "string" }, "minItems": 1 },
    "forbidden_scope": { "type": "array", "items": { "type": "string" } },
    "sandbox_mode": { "type": "string", "enum": ["read-only", "workspace-write", "danger-full-access"] },
    "approval_policy": { "type": "string", "enum": ["untrusted", "on-request", "never"] },
    "active_skills": { "type": "array", "items": { "type": "string" }, "minItems": 1 },
    "forbidden_skills": { "type": "array", "items": { "type": "string" } },
    "negative_matches": { "type": "array", "items": { "type": "string" } },
    "prompt_hash": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "started_at": { "type": "string", "minLength": 1 },
    "finished_at": { "type": ["string", "null"] },
    "exit_state": {
      "type": "string",
      "enum": ["DONE_WITH_EVIDENCE", "READY_BLOCKED_BY_PLATFORM_GATE", "OWNER_ONLY_IRREVERSIBLE_GATE", "FORBIDDEN_SCOPE_BLOCKER", "INSTRUCTION_SOURCE_DRIFT", "WRONG_TASK_CLASS_BLOCKER", "SAFETY_QUARANTINE"]
    },
    "evidence_refs": { "type": "array", "items": { "type": "string" }, "minItems": 1 },
    "validation_refs": { "type": "array", "items": { "type": "string" } },
    "token_budget_estimate": { "type": "integer", "minimum": 1 },
    "token_actual_if_available": { "type": ["integer", "null"], "minimum": 0 },
    "spawned_by": { "type": "string", "minLength": 1 },
    "no_user_interruption_proof": { "type": "string", "enum": ["PASS", "FAIL"] }
  }
}
