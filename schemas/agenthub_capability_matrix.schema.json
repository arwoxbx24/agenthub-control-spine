{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/arwoxbx24/agenthub-control-spine/schemas/agenthub_capability_matrix.schema.json",
  "title": "AgentHub Capability Matrix",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "run_id", "roles", "surfaces", "operations", "required_gates", "entries"],
  "properties": {
    "schema": { "const": "agenthub.capability_matrix.v1" },
    "run_id": { "type": "string", "minLength": 8 },
    "roles": { "type": "array", "minItems": 1, "items": { "type": "string" } },
    "surfaces": { "type": "array", "minItems": 1, "items": { "type": "string" } },
    "operations": { "type": "array", "minItems": 1, "items": { "type": "string" } },
    "required_gates": { "type": "array", "minItems": 1, "items": { "type": "string" } },
    "entries": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["role", "operation", "surface", "required_model", "authority", "required_gates", "decision"],
        "properties": {
          "role": { "type": "string", "minLength": 1 },
          "operation": { "type": "string", "minLength": 1 },
          "surface": { "type": "string", "minLength": 1 },
          "required_model": { "type": "string", "minLength": 1 },
          "authority": { "type": "string", "minLength": 1 },
          "required_gates": { "type": "array", "minItems": 1, "items": { "type": "string" } },
          "decision": { "type": "string", "minLength": 1 }
        }
      }
    }
  }
}
