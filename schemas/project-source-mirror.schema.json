{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "project-source-mirror.schema.json",
  "title": "ChatGPT Project Source Mirror",
  "type": "object",
  "required": [
    "stable_project_sources",
    "methodology_source",
    "catalog_path",
    "not_sixth_project_source",
    "raw_html_stored"
  ],
  "properties": {
    "stable_project_sources": {
      "type": "array",
      "minItems": 5,
      "maxItems": 5,
      "items": { "type": "string", "minLength": 1 }
    },
    "methodology_source": {
      "type": "object",
      "required": ["url", "read_route", "sha256"],
      "properties": {
        "url": { "type": "string", "minLength": 1 },
        "read_route": { "type": "string", "enum": ["agent_link_read"] },
        "sha256": { "type": "string", "minLength": 64 }
      }
    },
    "catalog_path": { "type": "string", "minLength": 1 },
    "not_sixth_project_source": { "type": "boolean", "const": true },
    "raw_html_stored": { "type": "boolean", "const": false }
  }
}

